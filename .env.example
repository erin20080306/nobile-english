# ===== Mobile English 環境變數範例 =====
# 複製此檔為 .env.local 後填入。沒有 Key 時會自動使用本機 fallback。

# OpenAI（真人感 AI Tutor，請放在 server 端，勿暴露於前端）
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Supabase（雲端帳號、TTS 快取資料表與私有音檔 bucket）
# 注意：service role key 僅限 server 端，切勿放入前端 bundle。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TTS_BUCKET=tts-audio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud Text-to-Speech（Chirp 3 HD 正式導師聲音，server 端）
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
# Chirp 3 HD 計價（USD / 每百萬字元），用於 prewarm dry-run 成本估算
CHIRP3HD_USD_PER_MILLION_CHARS=30

# OpenAI 語音辨識（STT，server 端）
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_FALLBACK_MODEL=gpt-4o-transcribe

# Gemini（高頻判斷，server 端）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase（替代雲端方案，可二擇一）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# 免費字典 API（未來擴充英英字典）
DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# RevenueCat（訂閱與付款管理）
NEXT_PUBLIC_REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Apple Sign In（iOS 登入）
APPLE_SIGN_IN_CLIENT_ID=com.mobileenglish.app
APPLE_SIGN_IN_REDIRECT_URI=https://nobile-english.vercel.app
